{
  "name": "talking-ben",
  "version": "1.0.0",
  "description": "Ad-free Talking Ben-style Windows desktop experience (original assets)",
  "main": "dist/main/main.js",
  "author": "Talking Ben for Windows",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "build:watch": "tsc --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "lint": "tsc --noEmit",
    "test": "node scripts/smoke-test.js",
    "test:electron": "node scripts/electron-smoke.js",
    "icons": "node scripts/generate-icon.js",
    "pack": "npm run build && electron-builder --win dir",
    "pack:zip": "npm run pack && node scripts/zip-portable.js",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "verify:no-ads": "node scripts/verify-no-ads.js"
  },
  "build": {
    "appId": "com.talkingben.desktop",
    "productName": "TalkingBen",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Talking Ben",
      "artifactName": "TalkingBen-Setup.${ext}",
      "uninstallDisplayName": "Talking Ben"
    },
    "portable": {
      "artifactName": "TalkingBen.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
